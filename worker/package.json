{
  "name": "singfolio-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "dev": "wrangler dev --infer-origin-from-routes=false",
    "migrations:create": "wrangler d1 migrations create DB",
    "migrations:apply:local": "wrangler d1 migrations apply DB --local",
    "migrations:apply:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "wrangler": "4.162.0"
  }
}
