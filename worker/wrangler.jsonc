// Singfolio のバックエンド（Cloudflare Workers + D1）。構成と理由は docs/singfolio-publishing-backend.md §8。
// 環境は「ローカル（wrangler dev。D1は .wrangler/state のローカルDB）」と「本番（singfolio.app）」の2つだけ。
// 開発用のクラウド側のWorker・D1は作らない（実機のログインの確認も、公開前の本番に対して行う）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "singfolio",
  "main": "src/index.ts",
  // 上げるときは、wranglerを上げて、動きが変わらないか確かめる。
  "compatibility_date": "2026-11-13",

  // 到達できる入口を singfolio.app だけにする（workers.dev とプレビューのURLは出さない）。
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "singfolio.app", "custom_domain": true }],

  // 未使用のアカウントの自動削除（src/inactiveAccounts.ts）。毎日1回、UTCの03:17（混みやすい正時を避ける）。
  // Freeは1アカウントに5つまで。Cron Trigger は、次の `wrangler deploy` で登録される。
  "triggers": { "crons": ["17 3 * * *"] },

  // ログに認証の値（セッション、nonce、Appleのコールバックの code・state、IDトークン）を出さない。
  // Workers Logs は無効のままにする。理由と、有効にするときの条件は docs/singfolio-publishing-backend.md §8「Workerの構成と運用」。
  // redact_query_string は、有効にしたときの安全弁（無効の間は効かない）。
  "observability": {
    "enabled": false,
    "redact_query_string": true
  },

  // 秘密情報は、このファイルにも、リポジトリにも書かない。本番は `wrangler secret put`、
  // ローカルは .dev.vars（gitignore。.dev.vars.example が見本）。ここに名前を書くと、
  // デプロイの前に、本番に無い秘密情報を検出でき、型（Env）にも出る。
  "secrets": {
    "required": ["NONCE_HMAC_KEY", "APPLE_PRIVATE_KEY"]
  },

  // IDトークンの `aud`（src/idToken.ts の audienceFor）。どれも公開してよい識別子で、秘密情報ではない
  // （アプリに埋め込まれる、またはAppleの設定画面で付けた名前）。Googleのクライアントの `client_secret` は使わない。
  // APPLE_BUNDLE_ID は app.json の ios.bundleIdentifier と同じ（test/config.test.ts が固定している）。
  //
  // APPLE_TEAM_ID・APPLE_KEY_ID は、AndroidのAppleログイン（Web経由）で、認可コードを交換するときの `client_secret`
  // （ES256のJWT）に入れる識別子。Team ID はアプリの署名にも入り、Key ID は秘密鍵（.p8。APPLE_PRIVATE_KEY。秘密情報）が
  // 無ければ使えない。どちらも秘密情報ではない。
  "vars": {
    "APPLE_BUNDLE_ID": "com.yskms.singfolio",
    "APPLE_SERVICES_ID": "com.yskms.singfolio.web",
    "APPLE_TEAM_ID": "3L2FPFG722",
    "APPLE_KEY_ID": "5J7N947KW6",
    "GOOGLE_WEB_CLIENT_ID": "432571830797-0b95abaac13gs6dkhcunkpni8d74lt6c.apps.googleusercontent.com"
  },

  // `database_id` は本番のD1のID（秘密ではない）。ローカルの開発・テストでは使われない。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "singfolio",
      "database_id": "32b6f13c-a7fe-43ef-826e-996b650a76af",
      "migrations_dir": "migrations"
    }
  ],

  // 公開スナップショット（7.4）。キーは `public/{username}.json`（docs §8「バックエンドが担当すること」）。
  // バケットは、利用者がダッシュボードで作る（デプロイの前に存在していないと `wrangler deploy` が失敗する）。
  // **バケットの公開アクセス（r2.dev のURL・カスタムドメイン）は有効にしない。** 読むのは Worker だけ
  // （公開ページ（7.5）も Worker が返す）。ローカルの開発・テストでは、バケットは作られず、メモリ上の代用が使われる。
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "singfolio-snapshots" }]
}
