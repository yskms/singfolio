{
  "expo": {
    "name": "Singfolio",
    "slug": "singfolio",
    "scheme": "singfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "com.yskms.singfolio",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yskms.singfolio",
      "adaptiveIcon": {
        "backgroundColor": "#C9FCED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#111113"
          }
        }
      ],
      "expo-sqlite",
      "./plugins/withIosSceneDelegate.js",
      "./plugins/withAndroidNightColors.js",
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Inter-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Noto Sans JP",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/NotoSansJP-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/NotoSansJP-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Inter-Regular.ttf",
              "./assets/fonts/Inter-Bold.ttf",
              "./assets/fonts/NotoSansJP-Regular.ttf",
              "./assets/fonts/NotoSansJP-Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "ja"]
          }
        }
      ]
    ]
  }
}
